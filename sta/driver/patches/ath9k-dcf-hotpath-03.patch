+static int
+ath9k_edca_apply(struct ath_softc *sc, int ac,
+		 const struct ath9k_tx_queue_info *base, bool overridden,
+		 u32 aifs, u32 cwmin, u32 cwmax)
+{
+	struct ath9k_tx_queue_info effective = *base;
+	struct ath_txq *txq;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	txq = sc->tx.txq_map[ac];
+	if (!txq)
+		return -ENODEV;
+
+	if (overridden) {
+		effective.tqi_aifs = aifs;
+		effective.tqi_cwmin = cwmin;
+		effective.tqi_cwmax = cwmax;
+	}
+	ath_update_max_aggr_framelen(sc, ac, effective.tqi_burstTime);
+	return ath_txq_update(sc, txq->axq_qnum, &effective);
+}
+
+int ath9k_edca_update_base(struct ath_softc *sc, int ac,
+			   const struct ath9k_tx_queue_info *qinfo)
+{
+	struct ath9k_edca_override *override;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	override = &sc->edca_override[ac];
+	override->base = *qinfo;
+	override->base_valid = true;
+
+	return ath9k_edca_apply(sc, ac, &override->base, override->enabled,
+				 override->aifs, override->cwmin, override->cwmax);
+}
+
+int ath9k_edca_override_set(struct ath_softc *sc, int ac, u32 aifs,
+			    u32 cwmin, u32 cwmax)
+{
+	struct ath9k_edca_override *override;
+	struct ath_txq *txq;
+	int ret;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	override = &sc->edca_override[ac];
+	if (!override->base_valid) {
+		txq = sc->tx.txq_map[ac];
+		if (!txq || !ath9k_hw_get_txq_props(sc->sc_ah, txq->axq_qnum,
+						      &override->base))
+			return -ENODEV;
+		override->base_valid = true;
+	}
+
+	ret = ath9k_edca_apply(sc, ac, &override->base, true,
+			       aifs, cwmin, cwmax);
+	if (ret)
+		return ret;
+	override->aifs = aifs;
+	override->cwmin = cwmin;
+	override->cwmax = cwmax;
+	override->override_valid = true;
+	override->enabled = true;
+	return 0;
+}
+
+int ath9k_edca_override_enable(struct ath_softc *sc, int ac)
+{
+	struct ath9k_edca_override *override;
+	int ret;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	override = &sc->edca_override[ac];
+	if (!override->override_valid || !override->base_valid)
+		return -ENOENT;
+	ret = ath9k_edca_apply(sc, ac, &override->base, true,
+			       override->aifs, override->cwmin, override->cwmax);
+	if (!ret)
+		override->enabled = true;
+	return ret;
+}
+
+int ath9k_edca_override_disable(struct ath_softc *sc, int ac, bool clear)
+{
+	struct ath9k_edca_override *override;
+	int ret = 0;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	override = &sc->edca_override[ac];
+	if (override->enabled) {
+		if (!override->base_valid)
+			return -ENOENT;
+		ret = ath9k_edca_apply(sc, ac, &override->base, false, 0, 0, 0);
+		if (ret)
+			return ret;
+		override->enabled = false;
+	}
+	if (clear)
+		override->override_valid = false;
+	return 0;
+}
+
+int ath9k_edca_apply_current(struct ath_softc *sc, int ac)
+{
+	struct ath9k_edca_override *override;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	override = &sc->edca_override[ac];
+	if (!override->base_valid)
+		return -ENOENT;
+	return ath9k_edca_apply(sc, ac, &override->base, override->enabled,
+				 override->aifs, override->cwmin, override->cwmax);
+}
