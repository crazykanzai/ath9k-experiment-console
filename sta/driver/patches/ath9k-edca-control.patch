+/*
+ * Runtime EDCA control for the four mac80211 access categories.
+ *
+ * Write format:
+ *   <AC> <AIFS> <CWmin> <CWmax>
+ * Example:
+ *   echo "BE 3 15 63" > edca_ctrl
+ *
+ * TXOP, readyTime and all other queue properties are preserved.
+ */
+static const char * const ath9k_edca_ac_names[IEEE80211_NUM_ACS] = {
+	[IEEE80211_AC_VO] = "VO",
+	[IEEE80211_AC_VI] = "VI",
+	[IEEE80211_AC_BE] = "BE",
+	[IEEE80211_AC_BK] = "BK",
+};
+
+static int ath9k_edca_ac_from_name(const char *name)
+{
+	int ac;
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		if (!strcasecmp(name, ath9k_edca_ac_names[ac]))
+			return ac;
+	}
+
+	return -EINVAL;
+}
+
+static bool ath9k_edca_cw_is_valid(u32 cw)
+{
+	switch (cw) {
+	case 1:
+	case 3:
+	case 7:
+	case 15:
+	case 31:
+	case 63:
+	case 127:
+	case 255:
+	case 511:
+	case 1023:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool ath9k_edca_aifs_is_valid(u32 aifs)
+{
+	return aifs >= 1 && aifs <= 15;
+}
+
+static ssize_t read_file_edca_ctrl(struct file *file, char __user *user_buf,
+				   size_t count, loff_t *ppos)
+{
+	struct ath_softc *sc = file->private_data;
+	struct ath9k_tx_queue_info qi;
+	struct ath_txq *txq;
+	char buf[512];
+	unsigned int len = 0;
+	int ac;
+
+	mutex_lock(&sc->mutex);
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		txq = sc->tx.txq_map[ac];
+		if (!txq) {
+			len += scnprintf(buf + len, sizeof(buf) - len,
+					 "AC=%s unavailable\n",
+					 ath9k_edca_ac_names[ac]);
+			continue;
+		}
+
+		if (!ath9k_hw_get_txq_props(sc->sc_ah, txq->axq_qnum, &qi)) {
+			len += scnprintf(buf + len, sizeof(buf) - len,
+					 "AC=%s qnum=%u inactive\n",
+					 ath9k_edca_ac_names[ac],
+					 txq->axq_qnum);
+			continue;
+		}
+
+		len += scnprintf(buf + len, sizeof(buf) - len,
+				 "AC=%s qnum=%u aifs=%u cwmin=%u cwmax=%u\n",
+				 ath9k_edca_ac_names[ac], txq->axq_qnum,
+				 qi.tqi_aifs, qi.tqi_cwmin, qi.tqi_cwmax);
+	}
+
+	mutex_unlock(&sc->mutex);
+
+	return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static ssize_t write_file_edca_ctrl(struct file *file,
+				    const char __user *user_buf,
+				    size_t count, loff_t *ppos)
+{
+	struct ath_softc *sc = file->private_data;
+	struct ath_common *common = ath9k_hw_common(sc->sc_ah);
+	struct ath9k_tx_queue_info qi;
+	struct ath_txq *txq;
+	char buf[64];
+	char ac_name[8];
+	char extra;
+	unsigned int aifs, cwmin, cwmax;
+	int ac, ret;
+
+	if (!count || count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+	buf[count] = '\0';
+
+	/* The trailing conversion rejects extra non-whitespace arguments. */
+	if (sscanf(buf, "%7s %u %u %u %c",
+		   ac_name, &aifs, &cwmin, &cwmax, &extra) != 4)
+		return -EINVAL;
+
+	ac = ath9k_edca_ac_from_name(ac_name);
+	if (ac < 0)
+		return ac;
+
+	if (!ath9k_edca_aifs_is_valid(aifs) ||
+	    !ath9k_edca_cw_is_valid(cwmin) ||
+	    !ath9k_edca_cw_is_valid(cwmax) ||
+	    cwmin > cwmax)
+		return -EINVAL;
+
+	txq = sc->tx.txq_map[ac];
+	if (!txq)
+		return -ENODEV;
+
+	ath9k_ps_wakeup(sc);
+	mutex_lock(&sc->mutex);
+
+	if (!ath9k_hw_get_txq_props(sc->sc_ah, txq->axq_qnum, &qi)) {
+		ret = -EIO;
+		goto out;
+	}
+
+	/* Preserve TXOP, readyTime and every other existing queue field. */
+	qi.tqi_aifs = aifs;
+	qi.tqi_cwmin = cwmin;
+	qi.tqi_cwmax = cwmax;
+
+	ret = ath_txq_update(sc, txq->axq_qnum, &qi);
+	if (!ret)
+		ath_info(common,
+			 "EDCA ctrl: AC=%s qnum=%u aifs=%u cwmin=%u cwmax=%u\n",
+			 ath9k_edca_ac_names[ac], txq->axq_qnum,
+			 aifs, cwmin, cwmax);
+
+out:
+	mutex_unlock(&sc->mutex);
+	ath9k_ps_restore(sc);
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations fops_edca_ctrl = {
+	.read = read_file_edca_ctrl,
+	.write = write_file_edca_ctrl,
+	.open = simple_open,
+	.owner = THIS_MODULE,
+	.llseek = default_llseek,
+};
