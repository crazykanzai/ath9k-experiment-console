+static int
+ath9k_edca_apply(struct ath_softc *sc, int ac,
+		 const struct ath9k_tx_queue_info *base, bool overridden,
+		 u32 aifs, u32 cwmin, u32 cwmax)
+{
+	struct ath9k_tx_queue_info effective = *base;
+	struct ath_txq *txq;
+
+	lockdep_assert_held(&sc->mutex);
+	if (ac < 0 || ac >= IEEE80211_NUM_ACS)
+		return -EINVAL;
+	txq = sc->tx.txq_map[ac];
+	if (!txq)
+		return -ENODEV;
+
+	if (overridden) {
+		effective.tqi_aifs = aifs;
+		effective.tqi_cwmin = cwmin;
+		effective.tqi_cwmax = cwmax;
+	}
+	ath_update_max_aggr_framelen(sc, ac, effective.tqi_burstTime);
+	return ath_txq_update(sc, txq->axq_qnum, &effective);
+}
