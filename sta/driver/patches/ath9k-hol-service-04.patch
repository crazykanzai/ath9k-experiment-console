+
+u64 ieee80211_hol_enqueue_time_ns(struct sk_buff *skb)
+{
+	const struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	u64 now_ns;
+	u32 elapsed;
+
+	if (!info->hol_enqueue_valid)
+		return 0;
+
+	/* CoDel stores ktime_get_ns() >> 10 in a wrapping u32. Do not infer an
+	 * enqueue time when the signed CoDel range (about 36 minutes) is exceeded.
+	 */
+	now_ns = ktime_get_ns();
+	elapsed = (u32)(now_ns >> CODEL_SHIFT) - info->control.enqueue_time;
+	if (elapsed >= BIT(31))
+		return 0;
+
+	return now_ns - ((u64)elapsed << CODEL_SHIFT);
+}
+EXPORT_SYMBOL_GPL(ieee80211_hol_enqueue_time_ns);
 
